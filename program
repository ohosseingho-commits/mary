    'فست‌فود':['پیتزا', 'همبرگر', 'هات‌داگ', 'ساندویچ'], 'غذای سرخ‌شده':['سوخاری', 'سیب‌زمینی سرخ‌کرده', 'سرخ‌کردنی'],
    'قهوه':['نسکافه', 'اسپرسو', 'کافی'], 'نوشابه':['کولا', 'پپسی'], 'شیرینی قنادی':['کیک', 'شیرینی'],
    'گوشت گاو':['گوساله', 'استیک'], 'چای پررنگ':['چای'], 'عسل طبیعی':['عسل'], 'نان سفید':['باگت', 'نان تست'],
    'مربای پرشکر':['مربا', 'شکر']
  };
  function norm(s){ return String(s).replace(/ي/g, 'ی').replace(/ك/g, 'ک').replace(/[آأإ]/g, 'ا').replace(/ۀ|هٔ/g, 'ه').replace(/[ً-ْٔ]/g, '').replace(/[\s‌‏‎]+/g, '').toLowerCase(); }
  var FOODS = [];
  function buildFoods(groups, good, host){
    var html = '';
    groups.forEach(function(g){
      html += '<div class="fgroup"><h4>' + g[0] + '</h4><div class="chips">';
      g[1].forEach(function(name){
        var idx = FOODS.length;
        FOODS.push({name:name, good:good, group:g[0], keys:[name].concat(ALIAS[name] || []).map(norm)});
        html += '<span class="chip ' + (good ? 'good' : 'bad') + '" data-f="' + idx + '">' + name + '</span>';
      });
      html += '</div></div>';
    });
    host.innerHTML = html;
  }
  buildFoods(GOOD, true, $('#goodList'));
  buildFoods(BAD, false, $('#badList'));

  var resEl = $('#results'), qEl = $('#foodQ');
  function runSearch(){
    var q = norm(qEl.value);
    document.querySelectorAll('.chip.hit').forEach(function(c){ c.classList.remove('hit'); });
    if (q.length < 2){ resEl.innerHTML = ''; return; }
    var hits = FOODS.filter(function(f){ return f.keys.some(function(k){ return k.indexOf(q) !== -1 || (k.length >= 3 && q.indexOf(k) !== -1); }); });
    if (!hits.length){
      resEl.innerHTML = '<p class="res-empty">این خوراکی در فهرست برنامه نیست. برای مصرفش با متخصص تغذیه مشورت کنید.</p>';
      return;
    }
    resEl.innerHTML = '';
    hits.slice(0, 6).forEach(function(f){
      var row = document.createElement('div'); row.className = 'res';
      var v = document.createElement('span'); v.className = 'verdict ' + (f.good ? 'good' : 'bad'); v.textContent = f.good ? 'مفید' : 'حذف شود';
      var n = document.createElement('b'); n.textContent = f.name;
      var g = document.createElement('small'); g.textContent = f.group;
      row.appendChild(v); row.appendChild(n); row.appendChild(g);
      resEl.appendChild(row);
      var chip = document.querySelector('.chip[data-f="' + FOODS.indexOf(f) + '"]'); if (chip) chip.classList.add('hit');
    });
  }
  qEl.addEventListener('input', runSearch);
  $('#examples').addEventListener('click', function(e){
    var b = e.target.closest('.ex'); if (!b) return;
    qEl.value = b.textContent; runSearch(); qEl.focus();
  });

  /* ---------- breathing ---------- */
  var PH = [{label:'دم', sec:4, scale:1}, {label:'نگه دارید', sec:2, scale:1}, {label:'بازدم', sec:6, scale:.55}];
  var orb = $('#orb'), orbLabel = $('#orbLabel'), bTime = $('#breathTime'), bBtn = $('#breathBtn'), bMsg = $('#breathMsg');
  var IDLE_TXT = bTime.textContent, run = null;
  function mmss(ms){ var s = Math.ceil(ms / 1000); return fa(Math.floor(s / 60)) + ':' + fa(pad(s % 60)); }
  function startBreath(){
    var mins = Number((document.querySelector('input[name="bdur"]:checked') || {}).value || 15);
    run = {end:Date.now() + mins * 60000, mins:mins, i:0, t:null, iv:null};
    bMsg.textContent = '';
    var step = function(){
      var ph = PH[run.i % PH.length]; run.i++;
      orbLabel.textContent = ph.label;
      orb.style.transitionDuration = ph.sec + 's';
      orb.style.transform = 'scale(' + ph.scale + ')';
      run.t = setTimeout(step, ph.sec * 1000);
    };
    run.iv = setInterval(tick, 500);
    step(); tick();
    bBtn.textContent = 'توقف';
  }
  function tick(){
    if (!run) return;
    var left = run.end - Date.now();
    if (left <= 0){ stopBreath(true); return; }
    bTime.textContent = 'باقی‌مانده ' + mmss(left);
  }
  function stopBreath(done){
    clearTimeout(run.t); clearInterval(run.iv);
    var mins = run.mins; run = null;
    orb.style.transitionDuration = '1s'; orb.style.transform = 'scale(.55)';
    orbLabel.textContent = done ? 'تمام شد' : 'آماده';
    bTime.textContent = IDLE_TXT;
    bBtn.textContent = 'شروع';
    if (done && mins >= 15){
      var k = today(); dayState(k).checks.calm = true; commit(k);
      bMsg.textContent = 'آرام‌سازی امروز در چک‌لیست ثبت شد.';
    } else if (done){
      bMsg.textContent = 'تمرین ' + fa(mins) + ' دقیقه‌ای تمام شد.';
    }
  }
  bBtn.addEventListener('click', function(){ if (run) stopBreath(false); else startBreath(); });

  /* ---------- boot ---------- */
  buildDial();
  dialEl = $('#dial'); handEl = $('#hand');
  renderClock(); renderToday();
  setInterval(function(){ renderClock(); if (today() !== renderedKey) renderToday(); }, 20000);
})();
</script>
