<meta charset="utf-8">
<title>روزانهٔ بانو</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Markazi+Text:wght@500;600;700&family=Vazirmatn:wght@300;400;500;600;700;800&display=swap">
<style>
/* Layout: the day drawn as a 24-hour sun dial up top, then the day's tools and guides in living order: today → meals → foods → drinks → calm → night. */
:root{
  --bg:#F1F4EA; --bg-glass:rgba(241,244,234,.9); --surface:#FBFCF6; --surface-2:#E6EBDC;
  --ink:#1C2A22; --muted:#56655B; --line:#D3DAC8;
  --accent:#9A5600; --on-accent:#FFF8EC; --accent-fill:#E2A23B; --accent-soft:#F6E5C3;
  --night:#34417E; --dusk:#A07FA8;
  --leaf:#246A44; --leaf-soft:#DAEADB; --pom:#AE2F3C; --pom-soft:#F5DFDD; --water:#15657B; --water-soft:#D4E9EE;
  --band:#1F2652; --band-ink:#ECEBF7; --band-muted:#B9BBDD; --band-line:#3A4277;
  --font-display:"Markazi Text","Vazirmatn",Georgia,serif;
  --font-body:"Vazirmatn",Tahoma,"Segoe UI",sans-serif;
  --r-sm:10px; --r-md:14px; --r-lg:22px;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#0F1613; --bg-glass:rgba(15,22,19,.88); --surface:#16201B; --surface-2:#1F2B25;
    --ink:#E5EBE1; --muted:#9DAAA0; --line:#2C3A33;
    --accent:#EFB04C; --on-accent:#1E1404; --accent-fill:#D9982F; --accent-soft:#36290F;
    --night:#8C98EA; --dusk:#C8A5CE;
    --leaf:#74C795; --leaf-soft:#18301F; --pom:#F07F88; --pom-soft:#3A1D21; --water:#68C7DD; --water-soft:#122E37;
    --band:#141A3A; --band-ink:#ECEBF7; --band-muted:#AEB1D6; --band-line:#2C3466;
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#0F1613; --bg-glass:rgba(15,22,19,.88); --surface:#16201B; --surface-2:#1F2B25;
  --ink:#E5EBE1; --muted:#9DAAA0; --line:#2C3A33;
  --accent:#EFB04C; --on-accent:#1E1404; --accent-fill:#D9982F; --accent-soft:#36290F;
  --night:#8C98EA; --dusk:#C8A5CE;
  --leaf:#74C795; --leaf-soft:#18301F; --pom:#F07F88; --pom-soft:#3A1D21; --water:#68C7DD; --water-soft:#122E37;
  --band:#141A3A; --band-ink:#ECEBF7; --band-muted:#AEB1D6; --band-line:#2C3466;
  color-scheme:dark;
}

*{box-sizing:border-box}
[hidden]{display:none!important}
@media (prefers-reduced-motion: no-preference){ html{scroll-behavior:smooth} }
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--font-body);font-size:16px;line-height:1.85;-webkit-font-smoothing:antialiased}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:10;background:var(--bg)}
h1,h2,h3,p,ul{margin:0}
ul{padding:0;list-style:none}
button,input{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--accent);outline-offset:3px;border-radius:6px}

.wrap{max-width:1120px;margin-inline:auto;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
.num{font-variant-numeric:tabular-nums}

/* top bar */
.topbar{position:sticky;top:env(safe-area-inset-top,0px);z-index:9;background:var(--bg-glass);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.topbar-in{display:flex;align-items:center;justify-content:space-between;gap:16px;padding-block:8px}
.brand{display:flex;align-items:center;gap:10px;font-family:var(--font-display);font-weight:700;font-size:28px;line-height:1;color:var(--ink);text-decoration:none;flex-shrink:0}
.brand svg{width:28px;height:28px}
.nav{display:flex;gap:2px;overflow-x:auto;min-width:0;scrollbar-width:none}
.nav::-webkit-scrollbar{display:none}
.nav a{flex-shrink:0;padding:6px 12px;border-radius:999px;color:var(--muted);text-decoration:none;font-size:14px;font-weight:500;white-space:nowrap}
.nav a:hover{background:var(--surface-2);color:var(--ink)}

/* hero */
.hero{padding-block:44px 32px}
.hero-grid{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);gap:48px;align-items:center}
.eyebrow{color:var(--muted);font-size:15px;font-weight:500}
.hero h1{font-family:var(--font-display);font-weight:700;font-size:clamp(48px,6.4vw,76px);line-height:1.05;margin-block:4px 10px;text-wrap:balance}
.lead{color:var(--muted);font-size:18px;max-width:32em}

.now{margin-top:26px;background:var(--surface);border:1px solid var(--line);border-radius:var(--r-lg);padding:22px 24px;display:grid;gap:10px}
.now-top{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
.pill{display:inline-flex;align-items:center;gap:6px;padding:2px 12px;border-radius:999px;font-size:13px;font-weight:600;background:var(--accent-soft);color:var(--accent)}
.pill .dot{width:7px;height:7px;border-radius:50%;background:currentColor}
@media (prefers-reduced-motion: no-preference){ .pill .dot{animation:pulse 2.4s ease-in-out infinite} }
@keyframes pulse{50%{opacity:.25}}
.now-range{color:var(--muted);font-size:14px}
.now-title{font-family:var(--font-display);font-size:38px;font-weight:700;line-height:1.15}
.now-detail{font-size:16px;max-width:36em}
.bar{height:6px;border-radius:99px;background:var(--surface-2);overflow:hidden}
.bar i{display:block;height:100%;width:0;background:var(--accent-fill);border-radius:99px;transition:width .6s ease}
.hint{display:flex;gap:10px;align-items:flex-start;padding:10px 14px;border-radius:var(--r-sm);background:var(--water-soft);color:var(--water);font-size:15px;font-weight:500}
.hint svg{flex-shrink:0;width:16px;height:20px;margin-top:4px}
.now-next{display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap;border-top:1px dashed var(--line);padding-top:12px;font-size:15px}
.now-next b{font-weight:600}
.now-next span{color:var(--muted)}

.dial-wrap{display:grid;justify-items:center;gap:16px}
.dial{width:100%;max-width:430px;height:auto;aspect-ratio:1/1;overflow:visible}
.dial .seg{transition:opacity .4s}
.dial.has-now .seg:not(.is-now){opacity:.5}
.dial-tick{stroke:var(--muted)}
.dial-num{fill:var(--muted);font-family:var(--font-body);font-size:13px;font-weight:500}
.dial-time{fill:var(--ink);font-family:var(--font-body);font-size:34px;font-weight:700}
.dial-label{fill:var(--accent);font-family:var(--font-body);font-size:13px;font-weight:600}
.dial-kicker{fill:var(--muted);font-family:var(--font-body);font-size:12px}
.legend{display:flex;flex-wrap:wrap;justify-content:center;gap:6px 18px;font-size:13px;color:var(--muted)}
.legend span{display:inline-flex;align-items:center;gap:6px}
.legend i{width:10px;height:10px;border-radius:3px;display:inline-block}

/* sections */
.sec{padding-block:64px;border-top:1px solid var(--line);scroll-margin-top:56px}
.sec-head{display:grid;gap:8px;margin-bottom:28px;max-width:44em}
.kicker{color:var(--accent);font-size:14px;font-weight:600}
.sec h2{font-family:var(--font-display);font-weight:700;font-size:clamp(34px,4.2vw,48px);line-height:1.1;text-wrap:balance}
.sec-sub{color:var(--muted);font-size:17px}
.panel{background:var(--surface);border:1px solid var(--line);border-radius:var(--r-lg);padding:22px}
.panel-h{display:flex;justify-content:space-between;align-items:baseline;gap:10px;margin-bottom:12px}
.panel-h h3{font-size:18px;font-weight:700}
.panel-h span{color:var(--muted);font-size:14px}

/* today */
.today-grid{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(0,1fr);gap:22px;align-items:start}
.side{display:grid;gap:22px}
.checklist{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:8px 28px}
.chk-group{min-width:0}
.chk-h{font-size:13px;font-weight:600;color:var(--muted);padding:12px 4px 4px}
.chk{position:relative;display:grid;grid-template-columns:26px minmax(0,1fr) auto;align-items:center;gap:12px;padding:10px 4px;border-bottom:1px solid var(--line);cursor:pointer}
.chk:last-child{border-bottom:0}
.chk input{position:absolute;opacity:0;width:1px;height:1px;pointer-events:none}
.box{width:24px;height:24px;border-radius:8px;border:1.5px solid var(--muted);display:grid;place-items:center;transition:background .2s,border-color .2s}
.box svg{width:16px;height:16px}
.box path{fill:none;stroke:var(--surface);stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round;stroke-dasharray:14;stroke-dashoffset:14;transition:stroke-dashoffset .25s ease}
.chk input:checked + .box{background:var(--leaf);border-color:var(--leaf)}
.chk input:checked + .box path{stroke-dashoffset:0}
.chk input:focus-visible + .box{outline:2px solid var(--accent);outline-offset:2px}
.chk input:checked ~ .chk-l{color:var(--muted)}
.chk-l{font-size:15.5px;font-weight:500}
.chk-t{font-size:13px;color:var(--muted);white-space:nowrap}
.chk:hover .box{border-color:var(--leaf)}

.score{display:grid;grid-template-columns:auto minmax(0,1fr);gap:18px;align-items:center}
.ring{width:112px;height:112px}
.ring circle{fill:none;stroke-width:10}
.ring .trk{stroke:var(--surface-2)}
.ring .val{stroke:var(--leaf);stroke-linecap:round;transition:stroke-dashoffset .6s ease}
.ring text{fill:var(--ink);font-family:var(--font-body);font-size:24px;font-weight:700}
.score-msg{font-size:15px}
.score-count{color:var(--muted);font-size:14px}
.week{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:8px;margin-top:18px;padding-top:16px;border-top:1px dashed var(--line)}
.wk{display:grid;justify-items:center;gap:6px;font-size:12px;color:var(--muted)}
.wk-bar{width:100%;max-width:26px;height:64px;border-radius:7px;background:var(--surface-2);display:flex;align-items:flex-end;overflow:hidden}
.wk-bar i{display:block;width:100%;background:var(--leaf);border-radius:7px;min-height:3px;transition:height .5s ease}
.wk.is-today{color:var(--ink);font-weight:700}
.wk.is-today .wk-bar{outline:1.5px solid var(--leaf);outline-offset:2px}

.glasses{display:flex;flex-wrap:wrap;gap:6px;direction:rtl}
.glass{width:34px;height:44px;padding:0;border:0;background:none;cursor:pointer;border-radius:8px}
.glass svg{width:100%;height:100%;display:block}
.glass .g-out{fill:none;stroke:var(--water);stroke-width:1.5;stroke-linejoin:round}
.glass .g-in{fill:transparent;transition:fill .2s}
.glass.full .g-in{fill:var(--water)}
.glass.extra .g-out{stroke-dasharray:3 2.5}
.glass:hover .g-in{fill:var(--water-soft)}
.glass.full:hover .g-in{fill:var(--water)}
.water-row{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-top:12px;flex-wrap:wrap}
.water-txt{font-size:15px}
.water-txt b{font-weight:700;color:var(--water)}
.water-goal{font-size:13px;color:var(--muted)}
.btn-ghost{border:1px solid var(--line);background:transparent;border-radius:999px;padding:4px 14px;font-size:14px;cursor:pointer;color:var(--muted)}
.btn-ghost:hover{color:var(--ink);border-color:var(--muted)}
.sync{margin-top:14px;font-size:13px;color:var(--muted);display:flex;gap:8px;align-items:center}
.sync i{width:8px;height:8px;border-radius:50%;background:var(--muted);flex-shrink:0}
.sync.cloud i{background:var(--leaf)}

/* meals */
.meals-grid{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:48px;align-items:start}
.meal{display:grid;grid-template-columns:150px minmax(0,1fr);gap:24px;padding-block:24px;border-top:1px solid var(--line)}
.meal:first-child{border-top:0;padding-top:0}
.meal-time{display:grid;align-content:start;gap:4px;justify-items:start}
.mt{font-family:var(--font-display);font-size:36px;font-weight:600;line-height:1.1;color:var(--accent)}
.mt-sub{font-size:13px;color:var(--muted)}
.meal-body{display:grid;gap:10px;min-width:0}
.meal h3{font-size:21px;font-weight:700;display:flex;align-items:baseline;gap:10px;flex-wrap:wrap}
.tag{font-size:13px;font-weight:500;color:var(--muted)}
.meal ul{display:grid;gap:6px}
.meal li{position:relative;padding-right:18px;font-size:16px}
.meal li::before{content:"";position:absolute;right:2px;top:.8em;width:6px;height:6px;border-radius:50%;background:var(--accent-fill)}
.pre-water{display:inline-flex;align-items:center;gap:8px;font-size:14px;font-weight:500;color:var(--water);background:var(--water-soft);padding:3px 12px;border-radius:999px;justify-self:start}
.pre-water svg{width:11px;height:14px}
.meal-note{font-size:14.5px;color:var(--muted);border-right:2px solid var(--accent-fill);padding-right:12px}
.pill.next{background:var(--surface-2);color:var(--muted)}
.rules{position:sticky;top:76px;display:grid;gap:18px}
.rules h3{font-family:var(--font-display);font-size:28px;font-weight:700;line-height:1.2}
.rule{display:grid;gap:2px;padding-top:14px;border-top:1px solid var(--line)}
.rule b{font-size:15px;font-weight:700}
.rule span{font-size:14.5px;color:var(--muted)}

/* foods */
.finder{background:var(--surface);border:1px solid var(--line);border-radius:var(--r-lg);padding:22px;margin-bottom:36px;display:grid;gap:12px}
.finder label{font-size:17px;font-weight:700}
.finder input{width:100%;font-size:18px;padding:12px 16px;border-radius:12px;border:1.5px solid var(--line);background:var(--bg);color:var(--ink);outline:none}
.finder input:focus{border-color:var(--accent)}
.examples{display:flex;flex-wrap:wrap;gap:6px;align-items:center;font-size:14px;color:var(--muted)}
.ex{border:1px dashed var(--line);background:none;border-radius:999px;padding:2px 12px;cursor:pointer;font-size:14px;color:var(--ink)}
.ex:hover{border-color:var(--accent);color:var(--accent)}
.results{display:grid;gap:6px}
.res{display:flex;align-items:center;gap:10px;flex-wrap:wrap;font-size:16px;padding:6px 0}
.res b{font-weight:600}
.res small{color:var(--muted);font-size:13px}
.verdict{display:inline-flex;align-items:center;gap:5px;font-size:13px;font-weight:700;padding:2px 10px;border-radius:999px}
.verdict.good{background:var(--leaf-soft);color:var(--leaf)}
.verdict.bad{background:var(--pom-soft);color:var(--pom)}
.res-empty{color:var(--muted);font-size:15px}
.food-cols{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:36px}
.fcol h3{font-size:20px;font-weight:700;display:flex;align-items:center;gap:10px;margin-bottom:6px}
.fcol h3 .mark{width:26px;height:26px;border-radius:50%;display:grid;place-items:center}
.fcol.good h3 .mark{background:var(--leaf-soft);color:var(--leaf)}
.fcol.bad h3 .mark{background:var(--pom-soft);color:var(--pom)}
.fcol h3 svg{width:14px;height:14px}
.fgroup{padding-block:12px;border-bottom:1px solid var(--line)}
.fgroup:last-child{border-bottom:0}
.fgroup h4{margin:0 0 8px;font-size:13px;font-weight:600;color:var(--muted)}
.chips{display:flex;flex-wrap:wrap;gap:6px}
.chip{display:inline-flex;align-items:center;padding:3px 12px;border-radius:999px;font-size:14.5px;line-height:1.7;transition:box-shadow .2s}
.chip.good{background:var(--leaf-soft);color:var(--leaf)}
.chip.bad{background:var(--pom-soft);color:var(--pom)}
.chip.hit{box-shadow:0 0 0 2px currentColor}

/* drinks */
.drinks{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:28px}
.drink{display:grid;gap:6px;padding-top:16px;border-top:2px solid var(--water)}
.drink .big{font-family:var(--font-display);font-size:44px;font-weight:700;line-height:1.05;color:var(--water)}
.drink p{font-size:15.5px;color:var(--muted)}
.nodrink{margin-top:36px;display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.nodrink b{font-size:15px;margin-left:6px}

/* calm */
.calm-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:40px;align-items:start}
.breath{display:grid;gap:18px;justify-items:center;text-align:center}
.orb-stage{position:relative;width:100%;max-width:250px;aspect-ratio:1/1;display:grid;place-items:center}
.orb-stage::before{content:"";position:absolute;inset:0;border-radius:50%;border:1.5px dashed var(--line)}
.orb{position:absolute;inset:0;border-radius:50%;background:var(--water-soft);box-shadow:inset 0 0 0 2px var(--water);transform:scale(.55);transition-property:transform;transition-timing-function:ease-in-out;transition-duration:1s}
.orb-label{position:relative;font-family:var(--font-display);font-size:34px;font-weight:700;color:var(--water)}
.breath-time{font-size:15px;color:var(--muted)}
.seg-ctl{display:inline-flex;border:1px solid var(--line);border-radius:999px;padding:3px;margin:0;gap:2px}
.seg-ctl legend{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
.seg-ctl input{position:absolute;opacity:0;pointer-events:none}
.seg-ctl label{padding:4px 14px;border-radius:999px;font-size:14px;cursor:pointer;color:var(--muted)}
.seg-ctl input:checked + label{background:var(--surface-2);color:var(--ink);font-weight:600}
.seg-ctl input:focus-visible + label{outline:2px solid var(--accent);outline-offset:1px}
.btn{border:0;border-radius:999px;padding:10px 30px;font-size:16px;font-weight:700;cursor:pointer;background:var(--accent);color:var(--on-accent)}
.btn:hover{filter:brightness(1.06)}
.breath-msg{font-size:14px;color:var(--leaf);min-height:1.6em}
.practices{display:grid;gap:22px}
.practice{display:grid;gap:4px}
.practice h3{font-size:19px;font-weight:700}
.practice p{color:var(--muted);font-size:15.5px}

/* night */
.night{background:var(--band);color:var(--band-ink);padding-block:72px;scroll-margin-top:56px}
.night .kicker{color:var(--accent-fill)}
.night h2{font-family:var(--font-display);font-weight:700;font-size:clamp(34px,4.2vw,48px);line-height:1.1}
.night .sec-sub{color:var(--band-muted)}
.seq{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));margin-top:36px}
.step{position:relative;display:grid;gap:4px;padding-top:28px;padding-left:12px}
.step::before{content:"";position:absolute;top:7px;right:0;left:0;height:1.5px;background:var(--band-line)}
.step::after{content:"";position:absolute;top:2px;right:0;width:12px;height:12px;border-radius:50%;background:var(--band);box-shadow:inset 0 0 0 2px var(--accent-fill)}
.step.sleep::after{background:var(--accent-fill)}
.step .t{font-family:var(--font-display);font-size:46px;font-weight:700;line-height:1}
.step b{font-size:16px;font-weight:700}
.step span{font-size:14.5px;color:var(--band-muted);max-width:18em}
.night-notes{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:28px;margin-top:48px;padding-top:28px;border-top:1px solid var(--band-line)}
.night-notes h3{font-size:18px;font-weight:700;margin-bottom:4px}
.night-notes p{color:var(--band-muted);font-size:15.5px}

footer{padding-block:36px 48px;color:var(--muted);font-size:14px}
footer p{max-width:60em}

@media (max-width: 900px){
  .hero-grid,.today-grid,.meals-grid,.calm-grid{grid-template-columns:minmax(0,1fr)}
  .hero-grid{gap:32px}
  .dial{max-width:360px}
  .rules{position:static}
}
@media (max-width: 640px){
  .hero{padding-block:28px 20px}
  .now{padding:18px}
  .now-title{font-size:32px}
  .sec{padding-block:48px}
  .meal{grid-template-columns:minmax(0,1fr);gap:8px}
  .meal-time{grid-auto-flow:column;justify-content:start;align-items:baseline;gap:10px}
  .mt{font-size:30px}
  .seq{grid-template-columns:repeat(2,minmax(0,1fr));row-gap:28px}
  .brand{font-size:24px}
  .brand svg{width:24px;height:24px}
  .score{grid-template-columns:minmax(0,1fr);justify-items:center;text-align:center}
}
@media (prefers-reduced-motion: reduce){
  *,*::before,*::after{transition-duration:0s!important;animation:none!important}
}
</style>

<div class="app" dir="rtl" lang="fa">
  <header class="topbar">
    <div class="wrap topbar-in">
      <a class="brand" href="#top" aria-label="روزانهٔ بانو">
